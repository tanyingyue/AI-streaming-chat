# 复制为 server/.env 后填写（可选）
# 不填则走 Mock 模式，无需真模型也能演示流式 + tool

# OpenAI 兼容接口（DeepSeek / 通义 / 月之暗面 / OpenAI 等）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# MySQL（可选）。HOST/USER/DATABASE 都填才会查库；否则 getOrder 用内存假数据
# 在 ocp_dev 中执行 server/sql/init_orders.sql 建表
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=ocp_dev
